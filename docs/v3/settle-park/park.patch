+/**
+ * ms from now until a strike WITHOUT a 'contact' mark lets its blow go: the attack's 'impact' mark (else 'release',
+ * else the art's attackImpactFrame) — the estimate parkBefore holds the victim for. null when the attacker is not on
+ * its attack (and no `from`) or is past that frame.
+ */
+export function strikeLeadIn(attacker: MonsterUnit | null, from?: number): number | null {
+  if (!attacker || !attacker.sprite.active) return null;
+  const m = attacker.spec('attack')?.marks;
+  const c = typeof m?.impact === 'number' ? m.impact : typeof m?.release === 'number' ? m.release : attacker.impactFrame;
+  if (typeof c !== 'number' || !Number.isFinite(c)) return null;
+  let f: number;
+  let into = 0;
+  let speed = 1;
+  if (from !== undefined) f = from;
+  else {
+    const fi = attacker.frameInfo();
+    if (fi.anim !== 'attack') return null;
+    f = fi.frame;
+    const a = attacker.sprite.anims as unknown as AnimState;
+    if (a.isPlaying) {
+      into = Math.max(0, a.accumulator || 0);
+      speed = a.timeScale > 0 ? a.timeScale : 1;
+    }
+  }
+  if (c <= f) return null;
+  return Math.max(0, attacker.rangeMs('attack', f, c) - into) / speed;
+}
