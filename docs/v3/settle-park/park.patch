+export interface ParkPlan {
+  /** The target frame the loop parks on. */
+  frame: number;
+  /** sprite.anims.timeScale on the way (1: untouched). */
+  speed: number;
+  /** ms (at speed) until the frame is reached. */
+  arriveIn: number;
