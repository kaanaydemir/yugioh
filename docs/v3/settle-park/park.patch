+ * own pace before the lead (shortest hold), else the one needing the least hurry (holds × ≥ PARK_FAST). Pure.
+ * null: no target at all, a one-frame loop, or none reachable even at PARK_FAST.
+ */
+export function planPark(loop: SettleLoop, leadIn: number, goal: SettleGoal, o: { fast?: number } = {}): ParkPlan | null {
+  const n = loop.holds.length;
+  if (n < 2 || loop.frame < 0 || loop.frame >= n) return null;
+  const fast = o.fast ?? PARK_FAST;
+  const holds = loop.holds.map((h) => Math.max(1, h));
+  const starts: number[] = [];
+  let L = 0;
+  for (const h of holds) {
+    starts.push(L);
+    L += h;
